# ModelOps — environment variable placeholders (Milestone 0)
# Copy to `.env` for local use. Never commit real secrets.

# --- Application ---
MODELOPS_ENV=development
MODELOPS_LOG_LEVEL=INFO
MODELOPS_API_HOST=0.0.0.0
MODELOPS_API_PORT=8000

# Path to the model artifact used by the API.
# Until Milestone 3 promotion, point at the local candidate from training:
MODELOPS_MODEL_PATH=models/candidates/baseline_linear_regression.joblib
# Later: models/approved/model.joblib

# --- Data ---
# Official TLC yellow taxi Parquet URL for one month (example placeholder).
# See docs/DATASET_AND_MODEL.md once Milestone 1 documents the chosen month.
MODELOPS_TAXI_DATA_URL=
MODELOPS_TAXI_YEAR=2024
MODELOPS_TAXI_MONTH=1
# Cap rows for local development (0 = no cap / use full downloaded month sample policy).
MODELOPS_MAX_ROWS=50000
MODELOPS_TRAIN_FRACTION=0.8
MODELOPS_RANDOM_SEED=42

# --- MLflow (local tracking; Milestone 3) ---
MLFLOW_TRACKING_URI=file:./mlruns
MLFLOW_EXPERIMENT_NAME=modelops-taxi-fare

# --- Model quality gates (placeholders; tuned in Milestone 1/3) ---
MODELOPS_MAX_MAE=
MODELOPS_MAX_RMSE=
MODELOPS_MIN_R2=

# --- Cloud (optional; Milestone 7+) — leave empty until you approve provisioning ---
# GCP_PROJECT_ID=
# GCP_REGION=us-central1
# ARTIFACT_REGISTRY_REPO=
# CLOUD_RUN_SERVICE=
