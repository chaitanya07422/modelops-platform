# Used by `gcloud builds submit`. Unlike .gitignore, we *include* the approved
# model so Cloud Run images can bake a demo artifact (models are still gitignored).

.git/
.github/
.venv/
venv/
ENV/
env/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
.tox/
.idea/
.vscode/
.DS_Store

data/raw/
data/processed/
!data/fixtures/
artifacts/
mlruns/
mlartifacts/
mlflow.db

# Candidates and history stay out of the image context; approved is included.
models/candidates/
models/approved/history/
models/approved/CURRENT.json

**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
.gcloud/
.kube/
*.log
logs/
tmp/
.temp/
docs/
monitoring/
*.md
!README.md
!pyproject.toml

.env
.env.*
*.pem
*.key
credentials.json
service-account*.json
